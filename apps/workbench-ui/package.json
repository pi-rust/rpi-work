{
  "name": "workbench-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fixture": "vite --mode fixture",
    "build": "npm run build:wasm && tsc -b && vite build",
    "build:fixture": "npm run build:wasm && tsc -b && vite build --mode fixture",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:fixture": "vite preview --mode fixture",
    "build:wasm": "cargo build --manifest-path ../../Cargo.toml -p work-viewmodel-wasm -p work-client-wasm --target wasm32-unknown-unknown --release --locked && wasm-bindgen --target web --out-dir src/pkg --out-name work_viewmodel ../../target/wasm32-unknown-unknown/release/work_viewmodel_wasm.wasm && wasm-bindgen --target web --out-dir src/pkg --out-name work_client ../../target/wasm32-unknown-unknown/release/work_client_wasm.wasm",
    "verify:fixture": "node scripts/verify-fixture.cjs",
    "verify:live": "node scripts/verify-live.cjs",
    "live:fixture": "node scripts/live-fixture.cjs",
    "verify:theme": "node scripts/verify-theme.cjs",
    "verify:mobile": "node scripts/verify-mobile.cjs",
    "verify:hosted": "node scripts/verify-hosted.cjs",
    "verify:a11y": "node scripts/verify-a11y.cjs",
    "verify:all": "node scripts/verify-all.cjs",
    "verify:settings": "node scripts/verify-settings.cjs",
    "verify:tree": "node scripts/verify-tree.cjs",
    "verify:browser": "node scripts/verify-browser.cjs",
    "verify:shell": "node scripts/verify-shell.cjs",
    "verify:creation": "node scripts/verify-creation.cjs",
    "verify:entry": "node scripts/verify-entry.cjs",
    "verify:session": "node scripts/verify-session.cjs",
    "verify:scopes": "node scripts/verify-scopes.cjs",
    "verify:reading": "node scripts/verify-reading.cjs",
    "verify:rich": "node scripts/verify-rich.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@headless-tree/core": "^1.8.0",
    "@headless-tree/react": "^1.8.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.77.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
