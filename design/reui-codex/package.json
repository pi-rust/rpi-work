{
  "name": "reui-codex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:wasm": "cargo build --manifest-path ../../Cargo.toml -p work-viewmodel-wasm -p work-client-wasm --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir src/pkg --out-name work_viewmodel ../../target/wasm32-unknown-unknown/release/work_viewmodel_wasm.wasm && wasm-bindgen --target web --out-dir src/pkg --out-name work_client ../../target/wasm32-unknown-unknown/release/work_client_wasm.wasm",
    "verify:fixture": "node scripts/verify-fixture.cjs",
    "verify:live": "node scripts/verify-live.cjs",
    "live:fixture": "node scripts/live-fixture.cjs",
    "verify:theme": "node scripts/verify-theme.cjs",
    "verify:mobile": "node scripts/verify-mobile.cjs",
    "verify:hosted": "node scripts/verify-hosted.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
